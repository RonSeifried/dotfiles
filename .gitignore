# never track secrets
*.key
*.pem
*.gpg
*.secret
*.age
*.p12
*.pfx
.env
.env.*
!.env.example
.netrc
.npmrc

# avoid caches
.cache/
__pycache__/
*.py[cod]
.local/share/
.mozilla/
.pki/
.rdesktop/
.vscode-oss/
Code - OSS/
VSCodium/
Obsidian/

# avoid app data
.config/discord/
.config/spotify/
.config/gtk-3.0/bookmarks
.config/gtk-4.0/*

# zed settings (contains API keys)
.config/zed/settings.json

# avoid logs + noise
*.log
*.tmp
tmp/
tmp/**

# editor and temporary backup files
*~
*.bak
*.orig
*.swp
*.swo
.#*

# do NOT track OS-generated stuff
.DS_Store
Thumbs.db

# backup directory (temporary, can be deleted after confirming changes)
.config/backup/
# TODO file (temporary, can be deleted after confirming changes)
TODO.md

# askai environment file (contains API keys)
.askai-env

/.config/starship/starship.toml

# Design/brainstorm docs — kept local, repo stays clean
docs/

# Per-host niri override (optional include, kept out of VCS)
.config/niri/includes/host.kdl
# Per-host kanshi monitor profiles (seeded from config.example by install.sh)
.config/kanshi/config
# Generated wallpaper colors (scripts/pywal-niri-colors.sh) — machine-local
.config/niri/includes/colors.kdl
.config/quickshell/settings.json
