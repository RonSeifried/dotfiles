// niri root config — splits live in includes/.
// Includes are positional: later files override earlier ones for merging
// sections (see https://github.com/YaLTeR/niri/wiki/Configuration:-Include).
//
// Add a per-host override at includes/host.kdl (gitignored) — picked up via
// the optional include below. Useful for travel-laptop / VM tweaks that
// shouldn't go in version control.

include "includes/input.kdl"
include "includes/layout.kdl"
include "includes/visuals.kdl"
include "includes/startup.kdl"
include "includes/window-rules.kdl"
include "includes/layer-rules.kdl"
include "includes/keybinds.kdl"

// Generated wallpaper colors (scripts/pywal-niri-colors.sh) — overrides the
// static fallbacks in layout.kdl. Machine-local, not tracked.
include optional=true "includes/colors.kdl"

include optional=true "includes/host.kdl"
