// Input devices + static output fallback (kanshi overrides outputs at runtime)

input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
    }

    // Focus windows when mouse enters them (mirrors Hyprland follow_mouse=1)
    focus-follows-mouse max-scroll-amount="0%"
}

// Monitor `output { … }` blocks are machine-specific and live in the
// (untracked) includes/host.kdl — see host.kdl.example. kanshi overrides
// position/scale/mode at runtime regardless.
