// Input devices + static output fallback (kanshi overrides outputs at runtime)

input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
    }

    // Focus windows when mouse enters them (mirrors Hyprland follow_mouse=1)
    focus-follows-mouse max-scroll-amount="0%"
}

// Static fallback output — kanshi overrides this dynamically
output "eDP-1" {
    scale 1.333333
}

// Per-output layout overrides (niri 25.11+). Inherits global `layout {}`,
// overrides selected keys. Kanshi controls position/scale/mode — layout-block
// here is independent and survives profile switches.
output "Microstep Optix MAG24C REDACTED-SERIAL" {
    layout {
        gaps 8
    }
}

output "Microstep G274QPF-QD REDACTED-SERIAL" {
    layout {
        gaps 8
    }
}
