// Window rules: corner radius, blur, floating apps, dialogs.

// Rounded corners on all windows. Blurring every application is one of the
// largest avoidable GPU costs; opaque apps gain nothing from sampling the
// wallpaper behind them.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Kitty is deliberately translucent, so it is the one normal application
// that benefits from compositor blur. Quickshell declares precise blur regions
// for its own surfaces separately.
window-rule {
    match app-id=r#"^kitty$"#
    background-effect {
        blur true
        noise 0.025
    }
}

window-rule {
    match is-floating=false
    tiled-state true
}

// Firefox / Zen PiP
window-rule {
    match app-id=r#"firefox$"# title=r#"^Picture-in-Picture$"#
    open-floating true
}
window-rule {
    match app-id=r#"zen-browser$"# title=r#"^Picture.in.Picture$"#
    open-floating true
}

// Generic PiP title match
window-rule {
    match title=r#"^Picture.in.Picture$"#
    open-floating true
}

// Floating utils — match terminals launched with --class=floating
window-rule {
    match app-id=r#"^floating$"#
    open-floating true
}

window-rule {
    match app-id=r#"^dropdown-terminal$"#
    open-floating true
    default-column-width { proportion 0.78; }
    default-window-height { proportion 0.46; }
}

// Installer terminal (yay-in-kitty spawned from launcher p-mode)
window-rule {
    match app-id=r#"^installer"#
    open-floating true
}

// MCP management terminal
window-rule {
    match app-id=r#"^mcp-management$"#
    open-floating true
}

// MCP gateway terminal
window-rule {
    match app-id=r#"^mcp-gateway$"#
    open-floating true
}

// MCP Manager — Quickshell floating window (matched by title; qs xdg app-id is shared)
window-rule {
    match title=r#"^MCP Manager$"#
    open-floating true
}

// File picker dialogs
window-rule {
    match title=r#"^(Open File|Save File|Choose Files?|Select File|Select Folder|Save As)"#
    open-floating true
}

// WezTerm initial configure workaround (from niri defaults)
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
