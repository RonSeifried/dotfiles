// Tiling layout, overview backdrop, recent-windows highlight.
// The color values below are STATIC FALLBACKS (used before the first
// `wallust run`). Live wallpaper colors come from the generated, machine-local
// includes/colors.kdl (scripts/pywal-niri-colors.sh), which niri deep-merges on
// top of these — so this file is never rewritten on a wallpaper change.

layout {
    gaps 5
    background-color "#2a2a2a"

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Disable focus-ring, use border instead (like Hyprland)
    focus-ring {
        off
    }

    border {
        on
        width 3
        active-color "#7e9cd8"
        inactive-color "#444444"
    }

    shadow {
        on
        softness 20
        spread 5
        offset x=0 y=5
        color "#00000066"
    }

    struts {
        // leave empty — quickshell bar uses layer-shell so no manual strut needed
    }
}

overview {
    backdrop-color "#2a2a2a"
    workspace-shadow {
        softness 40
        spread 8
        offset x=0 y=12
        color "#00000099"
    }
}

recent-windows {
    debounce-ms 750
    open-delay-ms 150
    highlight {
        // active = accent + α60 (Colors.accent overlay match)
        active-color "#7e9cd899"
        // urgent = color1 + α80 (matches Colors.error semantic, more attention than active)
        urgent-color "#c34a4acc"
        // radius matches Theme.radiusLarge (14) for QS-card consistency
        corner-radius 14
        padding 30
    }
    previews {
        max-scale 0.5
        max-height 480
    }
    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
    }
}
