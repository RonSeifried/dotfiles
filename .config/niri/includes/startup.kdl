// Autostart: shell, monitor profiles, theme, wallpaper, clipboard, lock, idle, session.

spawn-at-startup "qs"
spawn-at-startup "kanshi"

// Night-light gamma daemon (controlled by quickshell + Mod+F9/F10 over D-Bus)
spawn-at-startup "wl-gammarelay-rs"

// Lid-aware kanshi profile switcher (manages systemd-inhibit so logind
// only suspends when no external monitors are present).
spawn-sh-at-startup "~/.config/scripts/kanshi-lid-watcher.sh"

// Palette files are persistent and consumed directly by Quickshell/Kitty.
// Reapply only the compositor hook; running pywal at login could overwrite the
// newer Wallust palette and needlessly decode the wallpaper again.
spawn-sh-at-startup "~/.config/scripts/pywal-niri-colors.sh"

// Restore wallpaper. swaybg is reserved for the overview-only blurred layer;
// awww owns the normal desktop wallpaper.
spawn-sh-at-startup "WALLPAPER=\"$HOME/.cache/current_wallpaper\"; [ -f \"$WALLPAPER\" ] || exit 0; command -v awww >/dev/null 2>&1 || exit 0; pgrep -x awww-daemon >/dev/null || { awww-daemon & sleep 0.3; }; awww img \"$WALLPAPER\" --transition-type grow --transition-duration 2 --transition-pos center"
spawn-sh-at-startup "~/.config/scripts/wallpaper_switcher.sh --overview"

// Clipboard history
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "wl-clip-persist" "--clipboard" "both"

// Lock daemon (persistent, IPC-triggered for instant activation)
spawn-sh-at-startup "qs -d -p \"$HOME/.config/quickshell/lock\""

// Idle: 240s -> monitors off, 300s -> lock via IPC
spawn-sh-at-startup "swayidle -w timeout 240 'niri msg action power-off-monitors' timeout 300 'qs -p ~/.config/quickshell/lock ipc call lock lock' before-sleep 'qs -p ~/.config/quickshell/lock ipc call lock lock'"

// Session / keyring
spawn-at-startup "dbus-update-activation-environment" "--all"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets,ssh"

// Polkit agent — registered by quickshell itself (services/polkit/).
