{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": "  ", "key": { "width": 9 }, "color": { "keys": "blue" } },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS" },
    { "type": "kernel",   "key": "Kernel", "format": "{release}" },
    { "type": "wm",       "key": "WM" },
    { "type": "packages", "key": "Packages" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "battery",  "key": "Battery", "format": "{capacity} · {status}" },
    { "type": "memory",   "key": "Memory", "format": "{used} / {total} ({percentage})" },
    { "type": "disk",     "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "localip",  "key": "Network", "format": "{ipv4}", "showIpv6": false, "showLoop": false },
    { "type": "colors",   "symbol": "circle" }
  ]
}
