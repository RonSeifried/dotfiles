# ─────────────────────────────────────────────
# Starship Prompt — Wallust-driven palette
# Clean text-first prompt. Terminal background blocks looked harsh and cannot
# inherit the shell's rounded geometry, so hierarchy now comes from weight,
# spacing and wallpaper-derived foreground accents instead.
# ─────────────────────────────────────────────

format = """
$username$directory$git_branch$git_status$fill$python$nodejs$rust$time
$character
"""

add_newline = true
palette = "wal"

[username]
show_always = true
style_user = "bold color6"
style_root = "bold color5"
format = "[$user]($style) "

[directory]
truncation_length = 3
truncate_to_repo = false
style = "bold color15"
format = "[󰉋  $path]($style) "

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[git_branch]
symbol = ""
style = "color5"
format = "[on $symbol $branch]($style) "

[git_status]
style = "color6"
format = "[$all_status$ahead_behind]($style) "
stashed = " "
modified = " "
deleted = " "
staged = " "
untracked = " "

# ─────────────────────────────────────────────
# Right side
# ─────────────────────────────────────────────

[python]
symbol = "󰌠"
style = "color3"
format = "[$symbol $version]($style) "
pyenv_prefix = "venv"
disabled = false

[nodejs]
symbol = "󰎙"
style = "color2"
format = "[$symbol $version]($style) "
disabled = true

[rust]
symbol = ""
style = "color5"
format = "[$symbol $version]($style) "
disabled = true

[time]
disabled = false
time_format = "%H:%M"
style = "dimmed color15"
format = "[$time]($style) "

[fill]
symbol = " "

# ─────────────────────────────────────────────
# Prompt symbol
# ─────────────────────────────────────────────

[character]
success_symbol = "[❯](bold color6)"
error_symbol   = "[❯](bold color5)"
vicmd_symbol   = "[❮](bold color3)"
format = "$symbol "
