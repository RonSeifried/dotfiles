\.git
\.gitignore
\.gitattributes
\.gitmodules

\.tmp$

# Generated by hyprdynamicmonitors – machine-specific
^\.config/hypr/modules/monitors\.conf$

# Generated by wallust templates – do not stow
^\.config/waybar/style\.css$
^\.config/swaync/style\.css$

# Generated by legacy pywal hooks – do not stow
^\.config/hypr/modules/hyprland-pywal\.conf$

# Screenshots – not part of home config
# (stow full-matches each pattern against full path OR basename — no trailing slash)
^screenshots$
npm run preview
# Repo tooling, docs & meta – NOT home config (must never land in $HOME)
^install\.sh$
^packages$
^docs$
^tests$
^system$
^README\.md$
^CLAUDE\.md$
^LICENSE$
^design\.md$
^TODO\.md$
^\.askai-env\.example$

# Agent state dirs – real dirs in $HOME, never clobber via stow
^\.claude$
^\.superpowers$
^\.cache$

# Per-machine template files – the real host.kdl is seeded by install.sh
# (full-match basename, so prefix .* is required)
.*\.example
