# Battery charge thresholds: make them writable by the `wheel` group (so the
# Quickshell BatteryPanel can set them without root) and set an 80% baseline at
# boot. Path uses %k so BAT0/BAT1/… all match.
#
# Install:
#   sudo cp 99-charge-threshold.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=power_supply
#
# Permissions: applied on every add/change so a hotplugged battery stays writable.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT*", \
  RUN+="/usr/bin/chgrp wheel /sys/class/power_supply/%k/charge_control_start_threshold", \
  RUN+="/usr/bin/chgrp wheel /sys/class/power_supply/%k/charge_control_end_threshold", \
  RUN+="/usr/bin/chgrp wheel /sys/class/power_supply/%k/charge_behaviour", \
  RUN+="/usr/bin/chmod g+w /sys/class/power_supply/%k/charge_control_start_threshold", \
  RUN+="/usr/bin/chmod g+w /sys/class/power_supply/%k/charge_control_end_threshold", \
  RUN+="/usr/bin/chmod g+w /sys/class/power_supply/%k/charge_behaviour"

# Baseline: stop charging at 80%, resume below 75%. Only on `add` (boot/insert)
# so live changes from the shell aren't reset on every AC plug/unplug `change`.
ACTION=="add", SUBSYSTEM=="power_supply", KERNEL=="BAT*", \
  ATTR{charge_control_start_threshold}="75", \
  ATTR{charge_control_end_threshold}="80"
